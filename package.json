{
  "name": "lucide-brands",
  "version": "1.1.0",
  "description": "The brand icons removed from lucide-react 1.1 (Github, Twitter, Linkedin, Youtube, Instagram, Facebook, Slack, Figma...) as drop-in React components.",
  "keywords": [
    "brand-icons",
    "codemod",
    "github-icon",
    "icons",
    "lucide",
    "lucide-react",
    "lucide-react-1",
    "lucide-vue",
    "migration",
    "react",
    "svelte",
    "svg",
    "vue"
  ],
  "license": "ISC",
  "author": "Olzhas Azirali (https://github.com/azirali)",
  "homepage": "https://github.com/azirali/lucide-brands#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azirali/lucide-brands.git"
  },
  "bugs": "https://github.com/azirali/lucide-brands/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./nodes": {
      "import": {
        "types": "./dist/nodes.d.ts",
        "default": "./dist/nodes.js"
      },
      "require": {
        "types": "./dist/nodes.d.cts",
        "default": "./dist/nodes.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./svg/*": "./svg/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "lucide-brands": "cli/index.mjs"
  },
  "files": [
    "dist",
    "svg",
    "cli",
    "nodes",
    "vue"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs && node scripts/preview.mjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "preview": "node scripts/preview.mjs",
    "size": "node scripts/size.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@lucide/vue": ">=1.0.0",
    "lucide-react": ">=1.0.0",
    "react": "^16.5.1 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "vue": ">=3.2.0"
  },
  "peerDependenciesMeta": {
    "@lucide/vue": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lucide/vue": "^1.49.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "lucide": "^1.49.0",
    "lucide-react": "^1.49.0",
    "lucide-react-1.0.0": "npm:lucide-react@^1.0.0",
    "lucide-static-1.0.0": "npm:lucide-static@^1.0.0",
    "lucide-vue-1.0.0": "npm:lucide-vue-next@^1.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  }
}
